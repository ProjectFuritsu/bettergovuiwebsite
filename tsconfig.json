{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "checkJs": false,
        "resolveJsonModule": true,
        "types": ["vite/client"]
    },
    "include": ["src/studio"]
}
